---
import { ClientRouter } from "astro:transitions";
import "@fontsource/im-fell-english/latin-400.css";
import "@fontsource/im-fell-english/latin-400-italic.css";
import "@fontsource/im-fell-english-sc/latin-400.css";
import "@fontsource/unifrakturcook/latin-700.css";
import "@fontsource-variable/alegreya/wght.css";
import "@fontsource-variable/alegreya/wght-italic.css";
import "../styles/global.css";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const FIREFLY_COUNT = 14;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true" transition:persist>
      {Array.from({ length: FIREFLY_COUNT }, (_, index) => <span class="firefly" style={`--firefly-index: ${index}`} />)}
    </div>
    <div class="shell">
      <header class="masthead" transition:name="masthead" transition:animate="none">
        <a class="masthead__name" href="/">Arthur Thiele</a>
      </header>
      <main transition:animate="fade">
        <slot />
      </main>
      <footer class="site" transition:name="footer" transition:animate="none">
        <span class="site__flourish" aria-hidden="true"></span>
        arthurthiele.com
      </footer>
    </div>
    <script>
      import { ignoreLinksToCurrentPage } from "../ignoreLinksToCurrentPage";

      ignoreLinksToCurrentPage();
    </script>
  </body>
</html>
