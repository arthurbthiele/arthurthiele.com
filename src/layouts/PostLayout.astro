---
import BaseLayout from "./BaseLayout.astro";
import { typographicQuotes } from "../typographicQuotes";

interface Props {
  title: string;
  description: string;
  publishedOn: Date;
}

const { title, description, publishedOn } = Astro.props;

const formattedDate = publishedOn.toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric"
});
---

<BaseLayout title={`${typographicQuotes(title)} — Arthur Thiele`} description={typographicQuotes(description)}>
  <article>
    <h1>{typographicQuotes(title)}</h1>
    <p class="dateline"><time datetime={publishedOn.toISOString()}>{formattedDate}</time></p>
    <slot />
  </article>
</BaseLayout>
