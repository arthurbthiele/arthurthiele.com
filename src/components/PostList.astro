---
import { getCollection } from "astro:content";
import { typographicQuotes } from "../typographicQuotes";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf()
);
---

<ul class="index">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.publishedOn.toISOString()}>
        {post.data.publishedOn.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })}
      </time>
      <a href={`/writing/${post.id}`}>{typographicQuotes(post.data.title)}</a>
      <p>{typographicQuotes(post.data.description)}</p>
    </li>
  ))}
</ul>
