---
import { existsSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";

const PORTRAIT_FILE = "portrait.jpg";

const hasPortrait = existsSync(`public/${PORTRAIT_FILE}`);
---

<BaseLayout title="Arthur Thiele" description="Writing and small tools by Arthur Thiele.">
  <div class="intro">
    {hasPortrait && (
      <img class="intro__portrait" src={`/${PORTRAIT_FILE}`} alt="Arthur Thiele" width="112" height="112" />
    )}
    <div>
      <h1 class="visually-hidden">Arthur Thiele</h1>
      <p class="lede">Software engineer. I make things sometimes.</p>
    </div>
  </div>

  <EntryList />
</BaseLayout>
